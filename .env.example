# ComplessingFixerBy325Permill 変換設定
# Claude・scripts/fixer.py の両方がこの値を参照する

# 出力サイズ = input-baseSize/ の対応画像 × この倍率(%)。325 = 3.25倍。
SCALE_PERCENT=325

# 対応する基準画像が1件も取れなかったときの、入力画像に対する倍率(%)。
# （対応が一部でも取れていれば、その倍率の中央値を優先して使う）
FALLBACK_SCALE_PERCENT=95.5

# 圧縮のためのパレット色数(2-256)。
PALETTE_COLORS=256

# ディザリング(1=有効/0=無効)。
DITHER=1

# 対応付けキーの抽出正規表現（group(1)を大文字化して照合）
# 入力名: "_" 直後の 0xA形式 / 数字 / 単語 を採用
INPUT_KEY_RE=_(0x[A-Fa-f]|\d+|[^\W\d_]+)
# 基準名: 最初に現れる 0xA形式 / 数字 を採用
BASE_KEY_RE=(0x[A-Fa-f]|\d+)
